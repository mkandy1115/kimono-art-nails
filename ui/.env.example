# ----------------------------------------------------------------------------
# KIMONO Art Nails UI — environment variables
# Copy to ".env" for local development. On Cloudflare Pages, set these under
# Settings > Environment variables (and prefix with VITE_ so Vite exposes them).
# ----------------------------------------------------------------------------

# Base URL of the deployed API (Cloudflare Worker).
# Example: https://kimono-art-nails-api.your-subdomain.workers.dev
#
# Leave BLANK during local development — the Vite dev server proxies /api to
# the local Worker at http://localhost:8787 automatically (see vite.config.js).
# If the API is unreachable, the UI gracefully falls back to a bundled sample
# catalog so the site still renders.
VITE_API_URL=
