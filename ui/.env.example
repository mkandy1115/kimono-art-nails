# ----------------------------------------------------------------------------
# KIMONO Art Nails UI — environment variables
# Copy to ".env" for local development. On Cloudflare Pages, set these under
# Settings > Environment variables (and prefix with VITE_ so Vite exposes them).
# ----------------------------------------------------------------------------

# Base URL of the deployed API (Koyeb/Render).
# Example: https://kimono-art-nails-api-yourname.koyeb.app
#
# Leave BLANK during local development — the Vite dev server proxies /api to
# http://localhost:3000 automatically (see vite.config.js). If the API is
# unreachable, the UI gracefully falls back to a bundled sample catalog so the
# site still renders.
VITE_API_URL=
