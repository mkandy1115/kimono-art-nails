{
  // Cloudflare Workers configuration for the KIMONO Art Nails API.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kimono-art-nails-api",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://kimono-art-nails.pages.dev",
    "API_PUBLIC_URL": "https://kimono-art-nails.kyo-andrus.workers.dev",
    "CONTACT_FROM": "hello@kimonoartnails.com",
    "CONTACT_INBOX": "your-designated-email@gmail.com"
  },

  // Cloudflare R2 bucket for product photos.
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGE",
      "bucket_name": "product-image"
    }
  ],

  // Inquiry emails → CONTACT_INBOX. destination_address must match CONTACT_INBOX.
  // Verify the inbox under Email Routing → Destination Addresses, and onboard
  // CONTACT_FROM's domain under Email Sending → Onboard Domain.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "your-designated-email@gmail.com"
    }
  ]

  // Secrets (DATABASE_URL) are NOT stored here — use api/.dev.vars locally or
  // Workers → Settings → Variables (Encrypt) in production.
}
