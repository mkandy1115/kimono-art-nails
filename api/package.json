{
  "name": "kimono-art-nails-api",
  "version": "1.0.0",
  "private": true,
  "description": "Hono + Drizzle API for the KIMONO Art Nails catalog, running on Cloudflare Workers with a Neon PostgreSQL database.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "seed": "node src/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "wrangler": "^3.99.0"
  }
}
