# ----------------------------------------------------------------------------
# Local Worker variables for `wrangler dev`.
# Copy this file to ".dev.vars" (git-ignored) and fill in real values.
# These mirror the secrets/vars you set in the Cloudflare dashboard for prod.
# ----------------------------------------------------------------------------

# Neon PostgreSQL connection string (use the POOLED connection string).
# Leave blank to run the API in in-memory mode (serves the seed catalog).
DATABASE_URL=

# Comma-separated allowed frontend origins, or "*" for any.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL of this Worker (no trailing slash). When set, product `image` and
# `gallery` values that are R2 keys (e.g. sakura-haze/main.jpg) are expanded
# to full URLs like http://localhost:8787/images/sakura-haze/main.jpg
API_PUBLIC_URL=http://localhost:8787
