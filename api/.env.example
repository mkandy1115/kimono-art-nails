# ----------------------------------------------------------------------------
# KIMONO Art Nails API — environment variables
# Copy this file to ".env" for local development and fill in real values.
# On Koyeb / Render, set these in the platform's "Environment variables" panel.
# ----------------------------------------------------------------------------

# Port the API listens on. Hosting platforms (Koyeb/Render) inject this
# automatically, so you usually do NOT set it in production.
PORT=3000

# Node environment: "development" or "production".
NODE_ENV=development

# -------------------------- Database (Neon PostgreSQL) ----------------------
# Paste the connection string from your Neon project dashboard.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
# Leave this BLANK for local development to use the built-in in-memory
# catalog (handy before you have created a Neon account). When set, the API
# connects to PostgreSQL via Sequelize.
DATABASE_URL=

# ------------------------------- CORS ---------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Example for production:
#   ALLOWED_ORIGINS=https://kimono-art-nails.pages.dev,https://www.your-domain.com
# Use "*" to allow any origin (fine for a public read-only catalog).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
