# ----------------------------------------------------------------------------
# KIMONO Art Nails API — local tooling environment (Node).
#
# This file is read by the local database scripts that run with Node:
#   npm run db:push      (create/sync tables)
#   npm run db:generate  (generate SQL migrations)
#   npm run db:migrate   (apply migrations)
#   npm run seed         (load catalog data)
#
# Copy this file to ".env" and paste your Neon connection string.
#
# NOTE: The deployed Worker does NOT use this file. For `wrangler dev` use
# api/.dev.vars, and for production set variables in the Cloudflare dashboard.
# ----------------------------------------------------------------------------

# Neon PostgreSQL connection string (use the POOLED connection string).
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=
